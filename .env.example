# FOR-BAZI API 配置
# 请复制此文件为 .env 并填入你的 API Key
# API Key 只存储在本地，不会提交到 Git

# ── Cloudflare Workers AI (默认免费 AI) ──
# Account ID: Cloudflare 控制台右侧栏，或 `wrangler whoami`
# API Token:  控制台 → My Profile → API Tokens → Create Token
#             权限需包含 Account → Workers AI → Read
# 模型必须支持 function calling（ReAct 循环每轮都传工具 schema）
BAZI_CF_ACCOUNT_ID=your-cloudflare-account-id
BAZI_CF_API_TOKEN=your-cloudflare-api-token
BAZI_CF_MODEL=@cf/zai-org/glm-4.7-flash

# ── MiniMax API (OpenAI 兼容协议，可选) ──
BAZI_OPENAI_API_KEY=sk-cp-your-api-key-here
BAZI_OPENAI_BASE_URL=https://api.minimaxi.com/v1
BAZI_OPENAI_MODEL=MiniMax-M2.7

# ── 智谱 GLM API (Anthropic 兼容协议，可选) ──
BAZI_ANTHROPIC_API_KEY=your-glm-api-key-here
BAZI_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
